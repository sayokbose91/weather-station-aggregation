{
  "info": {
    "_postman_id": "2ccae69b-0ca5-4ed9-a979-29792948804d",
    "name": "Weather Station Aggregation",
    "description": "Set the apiKey variable to the same key the API uses (ApiKey:Value). baseUrl is http://localhost:5080, or http://localhost:8080 for Docker.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "No API key needed."
      }
    },
    {
      "name": "Aggregate",
      "item": [
        {
          "name": "Spec example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-ndjson"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stationName\":\"Hamburg\",\"temperature\":12.0}\n{\"stationName\":\"Bulawayo\",\"temperature\":8.9}\n{\"stationName\":\"Hamburg\",\"temperature\":34.2}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurements/aggregate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements",
                "aggregate"
              ]
            },
            "description": "The example from the spec. Expect Bulawayo 8.9/8.9/8.9 and Hamburg 12.0/23.1/34.2."
          }
        },
        {
          "name": "Station names (case variants)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-ndjson"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stationName\":\"hamburg\",\"temperature\":10.0}\n{\"stationName\":\"HAMBURG\",\"temperature\":20.0}\n{\"stationName\":\"new york\",\"temperature\":5.0}\n{\"stationName\":\"NEW YORK\",\"temperature\":15.0}\n{\"stationName\":\"st. john's\",\"temperature\":1.0}\n{\"stationName\":\"ST. JOHN'S\",\"temperature\":2.0}\n{\"stationName\":\"St. John's\",\"temperature\":3.0}\n{\"stationName\":\"rio de janeiro\",\"temperature\":25.0}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurements/aggregate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements",
                "aggregate"
              ]
            },
            "description": "Different casings are one station, and names come back in title case."
          }
        },
        {
          "name": "Bad lines",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-ndjson"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stationName\":\"Hamburg\",\"temperature\":12.0}\n{\"stationName\":\"Hamburg\",\"temperature\":34.2\n{\"stationName\":\"Hamburg\",\"temperature\":100.0}\n{\"stationName\":\"Hamburg\",\"temperature\":12.34}\n{\"stationName\":\"Hamburg\",\"temperature\":\"12.0\"}\n{\"stationName\":\"Hamburg\"}\n{\"stationName\":\"\",\"temperature\":5.0}\n{\"stationName\":\"Krung Thep Mahanakhon Amon Rattanakosin Mahinthara Ayuthaya Mahadilok Phop Noppharat Ratchathani Burirom Udomratchaniwet Mahasathan Amon Piman Awatan Sathit Sakkathattiya Witsanukam Prasit\",\"temperature\":28.5}\n{\"stationName\":\"Llanfairpwllgwyngyllgogerychwyrndrobwllllantysiliogogogoch\",\"temperature\":9.0}\n\n{\"stationName\":\"Bulawayo\",\"temperature\":8.9}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurements/aggregate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements",
                "aggregate"
              ]
            },
            "description": "Bad lines are skipped and saved. Run \"Failed lines\" afterwards to see them with the reason."
          }
        },
        {
          "name": "No API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-ndjson"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stationName\":\"hamburg\",\"temperature\":10.0}\n{\"stationName\":\"HAMBURG\",\"temperature\":20.0}\n{\"stationName\":\"new york\",\"temperature\":5.0}\n{\"stationName\":\"NEW YORK\",\"temperature\":15.0}\n{\"stationName\":\"st. john's\",\"temperature\":1.0}\n{\"stationName\":\"ST. JOHN'S\",\"temperature\":2.0}\n{\"stationName\":\"St. John's\",\"temperature\":3.0}\n{\"stationName\":\"rio de janeiro\",\"temperature\":25.0}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurements/aggregate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements",
                "aggregate"
              ]
            },
            "description": "Same request without the key."
          }
        }
      ]
    },
    {
      "name": "Failed lines",
      "item": [
        {
          "name": "Latest page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurements/failed?page=1&pageSize=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements",
                "failed"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Starts at 1."
                },
                {
                  "key": "pageSize",
                  "value": "50",
                  "description": "Default 50, max 500."
                }
              ]
            },
            "description": "Newest first. totalCount is the number of matching lines, not pages."
          }
        },
        {
          "name": "Between two times (UTC)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurements/failed?from=2026-11-17T00:00:00Z&to=2026-11-18T00:00:00Z&page=1&pageSize=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurements",
                "failed"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-11-17T00:00:00Z",
                  "description": "Optional, UTC."
                },
                {
                  "key": "to",
                  "value": "2026-11-18T00:00:00Z",
                  "description": "Optional, UTC."
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": ""
                },
                {
                  "key": "pageSize",
                  "value": "50",
                  "description": ""
                }
              ]
            },
            "description": "from and to are optional and filter on when the line failed."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "apiKey",
      "value": "your-api-key"
    }
  ]
}
